<table name="simple_video_learning_enrollments">
    <column name="enrollment_srl" type="number" size="11" notnull="notnull" primary_key="primary_key" />
    <column name="enrollment_key" type="varchar" size="80" notnull="notnull" unique="unique_enrollment_key" />
    <column name="course_srl" type="number" size="11" notnull="notnull" index="idx_course_srl" />
    <column name="member_srl" type="number" size="11" notnull="notnull" index="idx_member_srl" />
    <column name="active" type="char" size="1" default="Y" notnull="notnull" index="idx_active" />
    <column name="status" type="varchar" size="20" default="approved" notnull="notnull" index="idx_status" />
    <column name="decision_by" type="number" size="11" default="0" notnull="notnull" />
    <column name="decision_at" type="date" />
    <column name="regdate" type="date" index="idx_regdate" />
    <column name="last_update" type="date" index="idx_last_update" />
</table>
