<query id="updateCourse" action="update">
    <tables><table name="simple_video_learning_courses" /></tables>
    <columns>
        <column name="course_code" var="course_code" />
        <column name="title" var="title" />
        <column name="description" var="description" />
        <column name="num_sections" var="num_sections" filter="number" default="15" />
        <column name="enrollment_enabled" var="enrollment_enabled" />
        <column name="enrollment_mode" var="enrollment_mode" />
        <column name="is_published" var="is_published" />
        <column name="last_update" var="last_update" />
    </columns>
    <conditions>
        <condition operation="equal" column="course_srl" var="course_srl" filter="number" notnull="notnull" />
    </conditions>
</query>
