<query id="getEnrollmentsByCourse" action="select">
    <tables><table name="simple_video_learning_enrollments" /></tables>
    <columns><column name="*" /></columns>
    <conditions>
        <condition operation="equal" column="course_srl" var="course_srl" filter="number" notnull="notnull" />
        <condition operation="equal" column="active" var="active" default="Y" pipe="and" />
    </conditions>
</query>
